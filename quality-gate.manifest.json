{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "HMRC-OTG",
      "component": "ipv-cri-otg-hmrc",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-pr.yml",
            "path": "$.jobs.pre-commit"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-pr.yml",
            "path": "$.jobs.unit-tests"
          },
          "checks": [
            {
              "name": "unit"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-pr.yml",
            "path": "$.jobs.mocked-tests"
          },
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "regression"
            },
            {
              "name": "new feature"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-pr.yml",
            "path": "$.jobs.aws-tests"
          },
          "checks": [
            {
              "name": "component"
            },
            {
              "name": "integration"
            },
            {
              "name": "regression"
            },
            {
              "name": "new feature"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/scan-repo.yml",
            "path": "$.jobs.sonarcloud"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/scan-repo.yml",
            "path": "$.jobs.codeql"
          },
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ]
        }
      ]
    }
  ]
}
